# Public base URL of this app. Used to build the Entity ID, ACS URL and metadata URL
# you hand to each customer's IdP. If you use ngrok/Cloudflare Tunnel, put that URL here.
# https:// turns on Secure + __Host- cookies automatically.
BASE_URL=http://localhost:3000
PORT=3000

# Long random string. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is generated at boot (sessions die on every restart).
SESSION_SECRET=

# DEMO ONLY: treat every signed-in user as a tenant admin so you can reach /admin
# before you have configured a group claim in your IdP. Set to false once groups work.
DEMO_ADMIN_ALL=true
